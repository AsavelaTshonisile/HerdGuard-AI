# HerdGuard AI Backend Environment Configuration (Example)
PROJECT_NAME="HerdGuard AI"
API_V1_STR="/api"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite:///./herdguard.db"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Optional External AI service (fallback local rule-based + curated knowledge base active by default)
AI_PROVIDER="local"
OPENAI_API_KEY=""
